generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEDICHIVE_ADMIN
  INSTITUTE_ADMIN
  LAB_ADMIN
  DOCTOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  password       String
  name           String
  email          String          @unique
  address        String?
  nic            String?
  contactNo      String
  roles          UserRole
  dob            DateTime?
  gender         Gender
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  refreshToken   String?         @map("refresh_token")
  doctor         Doctor?
  instituteAdmin InstituteAdmin?
  labAdmin       LabAdmin?
  medichiveAdmin MedichiveAdmin?
  patient        Patient?
  lab            Lab?
  complaints     Complaint[]
}

model Doctor {
  id            String              @id @default(uuid())
  experience    Float
  licenseNumber String
  userId        String              @unique
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability  DoctorAvailability?
  DoctorRating  DoctorRating[]
}

model DoctorAvailability {
  id       Int    @id @default(autoincrement())
  doctorId String @unique
  doctor   Doctor @relation(fields: [doctorId], references: [id])
}

model DoctorSpecialization {
  id          Int    @id @default(autoincrement())
  name        String
  description String
}

model InstituteAdmin {
  id          Int        @id @default(autoincrement())
  userId      String     @unique
  instituteId Int?       @map("institute_id")
  user        User       @relation(fields: [userId], references: [id])
  institute   Institute? @relation(fields: [instituteId], references: [id])
}

model Patient {
  id           Int            @id @default(autoincrement())
  userId       String         @unique
  DoctorRating DoctorRating[]
  labReports   LabReport[]
  user         User           @relation(fields: [userId], references: [id])
}

model MedichiveAdmin {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model LabAdmin {
  id     Int    @id @default(autoincrement())
  userId String @unique
  labId  Int?   @map("lab_id")
  user   User   @relation(fields: [userId], references: [id])
  lab    Lab?   @relation(fields: [labId], references: [id])
}

model Institute {
  id                 Int              @id @default(autoincrement())
  name               String
  registrationNumber String
  contactNumber      String
  website            String
  address            String
  description        String
  certificate        String
  admins             InstituteAdmin[]
}

model Lab {
  id                 Int         @id @default(autoincrement())
  name               String
  registrationNumber String      @map("registration_number")
  contactNumber      String      @map("contact_number")
  website            String
  address            String
  description        String
  certificate        String
  userId             String      @unique @map("user_id")
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  labAdmins          LabAdmin[]
  labReports         LabReport[]

  @@map("labs")
}

model Appointment {
  id          Int    @id @default(autoincrement())
  description String
}

model Diagnosis {
  id          Int    @id @default(autoincrement())
  name        String
  description String
}

model drug {
  id          Int    @id @default(autoincrement())
  name        String
  code        String
  description String
}

model Rate {
  id Int @id @default(autoincrement())
}

model DoctorRating {
  id        Int      @id @default(autoincrement())
  doctorId  String
  patientId Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Complaint {
  id            Int       @id @default(autoincrement())
  complaintId   String    @unique @map("complaint_id")
  complaintText String    @map("complaint_text") @db.Text
  title         String?
  description   String?   @db.Text
  category      String    @default("GENERAL")
  priority      String    @default("MEDIUM")
  status        String    @default("OPEN")
  userId        String?   @map("user_id")
  userEmail     String?   @map("user_email")
  adminResponse String?   @map("admin_response") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  resolvedAt    DateTime? @map("resolved_at")
  user          User?     @relation(fields: [userId], references: [id])

  @@map("complaints")
}

model LabReport {
  id          Int      @id @default(autoincrement())
  patientId   Int      @map("patient_id")
  labId       Int?     @map("lab_id")
  description String   @db.Text
  reportLink  String?  @map("report_link")
  imagePath   String?  @map("image_path")
  pdfPath     String?  @map("pdf_path")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  patient     Patient  @relation(fields: [patientId], references: [id])
  lab         Lab?     @relation(fields: [labId], references: [id])

  @@map("lab_reports")
}
